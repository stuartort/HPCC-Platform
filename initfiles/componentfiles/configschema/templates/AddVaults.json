{
    "name": "Add AKeyless Feature",
    "description": "Add necessary keys with empty values for AKeyless feature",
    "type": "modification",
    "operations": [
        {
            "action": "delete",
            "target_path": "/Environment/Software/vaults",
            "data": {
                "error_if_not_found": false
            }
        },
        {
            "action": "create",
            "target_path": "/Environment/Software",
            "data": {
                "node_type": "vaults",
                "save": {
                    "name" : "vaults_node"
                }
            }
        },
        {
            "action": "create",
            "description": "Create the git element in Environment/Software/vaults",
            "target_nodeid": "{{vaults_node}}",
            "data": {
                "node_type": "git",
                "attributes": [
                    {
                        "name": "name",
                        "value": "git_akeyless"
                    },
                    {
                        "name": "url",
                        "value": "https://api.akeyless.io"
                    },
                    {
                        "name": "accessId",
                        "value": "your-access-id"
                    },
                    {
                        "name": "accessKeySecret",
                        "value": "accessKeySecret"
                    },
                    {
                        "name": "namespace",
                        "value": "optional-path-prefix"
                    }
                ]
            }
        },
        {
            "action": "create",
            "description": "Create the ecl element in Environment/Software/vaults",
            "target_nodeid": "{{vaults_node}}",
            "data": {
                "node_type": "ecl",
                "attributes": [
                    {
                        "name": "name",
                        "value": "ecl_akeyless"
                    },
                    {
                        "name": "url",
                        "value": "https://api.akeyless.io"
                    },
                    {
                        "name": "accessId",
                        "value": "your-access-id"
                    },
                    {
                        "name": "accessKeySecret",
                        "value": "accessKeySecret"
                    },
                    {
                        "name": "namespace",
                        "value": "optional-path-prefix"
                    }
                ]
            }
        },
        {
            "action": "create",
            "description": "Create the eclUser element in Environment/Software/vaults",
            "target_nodeid": "{{vaults_node}}",
            "data": {
                "node_type": "eclUser",
                "attributes": [
                    {
                        "name": "name",
                        "value": "eclUser_akeyless"
                    },
                    {
                        "name": "url",
                        "value": "https://api.akeyless.io"
                    },
                    {
                        "name": "accessId",
                        "value": "your-access-id"
                    },
                    {
                        "name": "accessKeySecret",
                        "value": "accessKeySecret"
                    },
                    {
                        "name": "namespace",
                        "value": "optional-path-prefix"
                    }
                ]
            }
        }
    ]
}
